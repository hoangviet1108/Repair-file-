{
  "name": "filefind",
  "productName": "FileFind",
  "version": "1.1.0",
  "description": "FileFind – kiểm tra lỗi và khôi phục video MP4/MOV bị hỏng (Sony XAVC), cho macOS & Windows",
  "main": "src/main.js",
  "bin": {
    "filefind": "cli/filefind.js"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "keywords": [
    "video",
    "repair",
    "mp4",
    "mov",
    "xavc",
    "sony",
    "fx3",
    "moov",
    "recovery"
  ],
  "license": "MIT",
  "homepage": "https://github.com/hoangviet1108/Repair-file-",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoangviet1108/Repair-file-.git"
  },
  "bugs": {
    "url": "https://github.com/hoangviet1108/Repair-file-/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "44.11.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "io.github.hoangviet1108.filefind",
    "productName": "FileFind",
    "artifactName": "FileFind-${version}-${os}-${arch}.${ext}",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "afterPack": "build/after-pack.js",
    "mac": {
      "category": "public.app-category.video",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "FileFind-${version}-portable.${ext}"
    },
    "publish": null
  }
}
